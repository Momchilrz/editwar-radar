# Comma-separated Wikimedia server_name values. Default is English Wikipedia.
WIKIS=en.wikipedia.org
WINDOW_HOURS=6
REFRESH_SECONDS=60
# Wikimedia asks for a contact they can reach. Change this before a long run.
UA_CONTACT=your@email
DATABASE_URL=sqlite:///./data/editwar.db
SKIP_MINOR=false
MAIN_NAMESPACE_ONLY=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
LEADERBOARD_MIN_REVERTS=2
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
BACKFILL=true
DISABLE_INGEST=false
